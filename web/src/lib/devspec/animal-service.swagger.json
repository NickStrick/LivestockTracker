{
  "openapi": "3.1.0",
  "info": {
    "title": "animal-service",
    "description": "Owns animal records, identifiers, ranches, zones, and the shared audit trail.",
    "version": "0.1.0"
  },
  "paths": {
    "/animals": {
      "post": {
        "tags": [
          "animals"
        ],
        "summary": "Create Animal",
        "description": "Create an animal, logging its creation to the audit trail and outbox\nin the same transaction. 409s if tag_id is already in use.\n\nArgs:\n    body: Fields for the new animal.\n    db: Database session (injected).\n    user: The authenticated caller (injected); its id is recorded as\n        the audit event's actor.\n\nReturns:\n    AnimalOut: The newly created animal.\n\nRaises:\n    HTTPException: 409 if `body.tag_id` is already in use by another\n        animal.",
        "operationId": "create_animal_animals_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnimalCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnimalOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "animals"
        ],
        "summary": "List Animals",
        "description": "List animals, newest first, optionally filtered by ranch and/or\nlifecycle status.\n\nArgs:\n    ranch_id: If given, only return animals belonging to this ranch.\n    status_filter: If given, only return animals in this lifecycle\n        status (active|sold|deceased).\n    db: Database session (injected).\n    user: The authenticated caller (injected); unused beyond requiring\n        authentication for this endpoint.\n\nReturns:\n    List[AnimalOut]: Matching animals, newest-created first.",
        "operationId": "list_animals_animals_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "ranch_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Ranch Id"
            }
          },
          {
            "name": "status_filter",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status Filter"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AnimalOut"
                  },
                  "title": "Response List Animals Animals Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/animals/{animal_id}": {
      "get": {
        "tags": [
          "animals"
        ],
        "summary": "Get Animal",
        "description": "Fetch a single animal by id, or 404 if it doesn't exist.\n\nArgs:\n    animal_id: id of the animal to fetch.\n    db: Database session (injected).\n    user: The authenticated caller (injected); unused beyond requiring\n        authentication for this endpoint.\n\nReturns:\n    AnimalOut: The requested animal.\n\nRaises:\n    HTTPException: 404 if no animal with `animal_id` exists.",
        "operationId": "get_animal_animals__animal_id__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "animal_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Animal Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnimalOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "animals"
        ],
        "summary": "Update Animal",
        "description": "Apply a partial update and log it to the audit trail -- a status\nchange gets its own event type/outbox event since that's the\ntransition most consumers care about; any other field change logs as a\ngeneric animal_updated event.\n\nArgs:\n    animal_id: id of the animal to update.\n    body: Fields to change; unset fields are left unchanged.\n    db: Database session (injected).\n    user: The authenticated caller (injected); its id is recorded as\n        the audit event's actor.\n\nReturns:\n    AnimalOut: The updated animal.\n\nRaises:\n    HTTPException: 404 if no animal with `animal_id` exists.",
        "operationId": "update_animal_animals__animal_id__patch",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "animal_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Animal Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnimalUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnimalOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/animals/{animal_id}/lineage": {
      "get": {
        "tags": [
          "animals"
        ],
        "summary": "Get Lineage",
        "description": "Return an animal's sire, dam, and offspring (one generation each\ndirection -- not a full pedigree tree).\n\nArgs:\n    animal_id: id of the animal to look up lineage for.\n    db: Database session (injected).\n    user: The authenticated caller (injected); unused beyond requiring\n        authentication for this endpoint.\n\nReturns:\n    dict: `{\"animal_id\", \"sire\", \"dam\", \"offspring\"}`, where sire/dam\n        are an AnimalOut or None, and offspring is a list of AnimalOut.\n\nRaises:\n    HTTPException: 404 if no animal with `animal_id` exists.",
        "operationId": "get_lineage_animals__animal_id__lineage_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "animal_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Animal Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "title": "Response Get Lineage Animals  Animal Id  Lineage Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/animals/{animal_id}/audit-trail": {
      "get": {
        "tags": [
          "animals"
        ],
        "summary": "Get Audit Trail",
        "description": "List this animal's audit_events, oldest first.\n\nArgs:\n    animal_id: id of the animal whose audit trail to fetch.\n    db: Database session (injected).\n    user: The authenticated caller (injected); unused beyond requiring\n        authentication for this endpoint.\n\nReturns:\n    List[AuditEventOut]: This animal's audit events, oldest first.\n\nRaises:\n    HTTPException: 404 if no animal with `animal_id` exists.",
        "operationId": "get_audit_trail_animals__animal_id__audit_trail_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "animal_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Animal Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AuditEventOut"
                  },
                  "title": "Response Get Audit Trail Animals  Animal Id  Audit Trail Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/animals/{animal_id}/identifiers": {
      "post": {
        "tags": [
          "animals"
        ],
        "summary": "Add Identifier",
        "description": "Attach an RFID/EID/tattoo/muzzle-print identifier to an animal.\nRestricted to admin/vet/field_worker roles; 409s if the identifier\nvalue is already attached to another animal (see Identifier's unique\nconstraint in app/models.py).\n\nArgs:\n    animal_id: id of the animal to attach the identifier to.\n    body: The identifier's type/value/issuer.\n    db: Database session (injected).\n    user: The authenticated caller (injected), restricted to the\n        admin/vet/field_worker roles; its id is recorded as the audit\n        event's actor.\n\nReturns:\n    IdentifierOut: The newly created identifier.\n\nRaises:\n    HTTPException: 404 if no animal with `animal_id` exists; 403 if\n        `user`'s role isn't admin/vet/field_worker; 409 if\n        `body.value` is already attached to another animal.",
        "operationId": "add_identifier_animals__animal_id__identifiers_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "animal_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Animal Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IdentifierCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IdentifierOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/ranches": {
      "get": {
        "tags": [
          "ranches"
        ],
        "summary": "List Ranches",
        "description": "List all ranches, newest first.\n\nArgs:\n    db: Database session (injected).\n    user: The authenticated caller (injected); unused beyond requiring\n        authentication for this endpoint.\n\nReturns:\n    List[RanchOut]: All ranches, newest-created first.",
        "operationId": "list_ranches_ranches_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RanchOut"
                  },
                  "type": "array",
                  "title": "Response List Ranches Ranches Get"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      },
      "post": {
        "tags": [
          "ranches"
        ],
        "summary": "Create Ranch",
        "description": "Onboard a ranch: validate its boundary as a well-formed, non-\nself-intersecting polygon and store it as PostGIS geography.\n\nArgs:\n    body: Name, owning customer, and boundary ring for the new ranch.\n    db: Database session (injected).\n    user: The authenticated caller (injected); unused beyond requiring\n        authentication for this endpoint.\n\nReturns:\n    RanchOut: The newly created ranch.\n\nRaises:\n    HTTPException: 422 if `body.boundary` forms a self-intersecting or\n        otherwise invalid polygon.",
        "operationId": "create_ranch_ranches_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RanchCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RanchOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/ranches/{ranch_id}": {
      "get": {
        "tags": [
          "ranches"
        ],
        "summary": "Get Ranch",
        "description": "Fetch a single ranch by id, or 404 if it doesn't exist.\n\nArgs:\n    ranch_id: id of the ranch to fetch.\n    db: Database session (injected).\n    user: The authenticated caller (injected); unused beyond requiring\n        authentication for this endpoint.\n\nReturns:\n    RanchOut: The requested ranch.\n\nRaises:\n    HTTPException: 404 if no ranch with `ranch_id` exists.",
        "operationId": "get_ranch_ranches__ranch_id__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "ranch_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Ranch Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RanchOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/ranches/{ranch_id}/audit-trail": {
      "get": {
        "tags": [
          "ranches"
        ],
        "summary": "Get Ranch Audit Trail",
        "description": "List this ranch's audit_events (ranch- and zone-scoped), oldest first.\n\nArgs:\n    ranch_id: id of the ranch whose audit trail to fetch.\n    db: Database session (injected).\n    user: The authenticated caller (injected); unused beyond requiring\n        authentication for this endpoint.\n\nReturns:\n    List[AuditEventOut]: This ranch's audit events, oldest first.\n\nRaises:\n    HTTPException: 404 if no ranch with `ranch_id` exists.",
        "operationId": "get_ranch_audit_trail_ranches__ranch_id__audit_trail_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "ranch_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Ranch Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AuditEventOut"
                  },
                  "title": "Response Get Ranch Audit Trail Ranches  Ranch Id  Audit Trail Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/ranches/{ranch_id}/zones": {
      "post": {
        "tags": [
          "zones"
        ],
        "summary": "Create Zone",
        "description": "Create a zone: validate its boundary polygon, require it lie fully\nwithin the parent ranch's boundary, then log the creation to the audit\ntrail and outbox in the same transaction.\n\nArgs:\n    ranch_id: id of the parent ranch this zone belongs to.\n    body: Name, type, description, and boundary ring for the new zone.\n    db: Database session (injected).\n    user: The authenticated caller (injected); its id is recorded as\n        the audit event's actor.\n\nReturns:\n    ZoneOut: The newly created zone.\n\nRaises:\n    HTTPException: 404 if no ranch with `ranch_id` exists; 422 if\n        `body.boundary` is an invalid polygon or doesn't lie fully\n        within the parent ranch's boundary.",
        "operationId": "create_zone_ranches__ranch_id__zones_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "ranch_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Ranch Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ZoneCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ZoneOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "zones"
        ],
        "summary": "List Zones",
        "description": "List zones in a ranch, newest first, optionally filtered by type.\n\nArgs:\n    ranch_id: id of the parent ranch.\n    zone_type: If given, only return zones of this type\n        (pasture|water|dangerous_terrain|forest|paddock|quarantine).\n    db: Database session (injected).\n    user: The authenticated caller (injected); unused beyond requiring\n        authentication for this endpoint.\n\nReturns:\n    List[ZoneOut]: Matching zones, newest-created first.\n\nRaises:\n    HTTPException: 404 if no ranch with `ranch_id` exists.",
        "operationId": "list_zones_ranches__ranch_id__zones_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "ranch_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Ranch Id"
            }
          },
          {
            "name": "zone_type",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Zone Type"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ZoneOut"
                  },
                  "title": "Response List Zones Ranches  Ranch Id  Zones Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/ranches/{ranch_id}/zones/{zone_id}": {
      "get": {
        "tags": [
          "zones"
        ],
        "summary": "Get Zone",
        "description": "Fetch a single zone by id, or 404 if it or its parent ranch don't exist.\n\nArgs:\n    ranch_id: id of the zone's expected parent ranch.\n    zone_id: id of the zone to fetch.\n    db: Database session (injected).\n    user: The authenticated caller (injected); unused beyond requiring\n        authentication for this endpoint.\n\nReturns:\n    ZoneOut: The requested zone.\n\nRaises:\n    HTTPException: 404 if no ranch with `ranch_id` exists, or no zone\n        with `zone_id` exists under it.",
        "operationId": "get_zone_ranches__ranch_id__zones__zone_id__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "ranch_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Ranch Id"
            }
          },
          {
            "name": "zone_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Zone Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ZoneOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "zones"
        ],
        "summary": "Update Zone",
        "description": "Apply a partial update and log it to the audit trail -- deactivating\na zone (e.g. lifting a quarantine) stamps lifted_at and gets its own\nzone_lifted event/outbox entry; any other change logs as a generic\nzone_updated event, mirroring the animals router's status_change\nhandling.\n\nArgs:\n    ranch_id: id of the zone's expected parent ranch.\n    zone_id: id of the zone to update.\n    body: Fields to change; unset fields are left unchanged.\n    db: Database session (injected).\n    user: The authenticated caller (injected); its id is recorded as\n        the audit event's actor.\n\nReturns:\n    ZoneOut: The updated zone.\n\nRaises:\n    HTTPException: 404 if no ranch with `ranch_id` exists, or no zone\n        with `zone_id` exists under it.",
        "operationId": "update_zone_ranches__ranch_id__zones__zone_id__patch",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "ranch_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Ranch Id"
            }
          },
          {
            "name": "zone_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Zone Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ZoneUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ZoneOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Healthz",
